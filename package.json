{
  "name": "cascade-springs",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "mobile": "pnpm --dir mobile start",
    "ios": "pnpm --dir mobile ios",
    "ios:build": "pnpm --dir mobile exec eas build --platform ios --profile development",
    "ios:install": "pnpm --dir mobile exec eas build:run --platform ios --profile development --latest",
    "android": "pnpm --dir mobile android",
    "web": "pnpm --dir mobile web",
    "backend:dev": "pnpm --dir backend dev",
    "backend:build": "pnpm --dir backend build",
    "backend:start": "pnpm --dir backend start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "bundle:check": "pnpm --dir mobile bundle:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:ci && pnpm bundle:check"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
