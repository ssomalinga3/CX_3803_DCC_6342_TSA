# Backend environment configuration (copy to .env for local development).
# Never commit a real .env. Credentials come from the environment or managed
# secrets per docs/security.md.

# HTTP port the server binds to.
PORT=3000

# Node environment: development | test | production
NODE_ENV=development

# --- Not yet consumed by the scaffold; added here as placeholders for the
# --- first implementation tasks. Leave unset until the corresponding module
# --- lands (see docs/architecture.md and docs/decisions.md D-01/D-03/D-10).
# DATABASE_URL=postgres://user:password@localhost:5432/cascade_springs
# AWS_REGION=us-east-1
# S3_BUCKET=
# SMTP_URL=
