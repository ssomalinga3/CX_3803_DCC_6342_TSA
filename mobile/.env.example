# Public configuration only; this value is embedded in the JavaScript bundle.
# Local iOS Simulator: Worker origin plus /api/v1 (not /layers).
EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1
# Android Emulator: http://10.0.2.2:8787/api/v1
# Physical device: trusted LAN host, never localhost. See backend/GIS-HANDOFF.md.
# Production requires an approved HTTPS API. Never put credentials here.
# If unset, the Map tab works as a basemap-only preview.
